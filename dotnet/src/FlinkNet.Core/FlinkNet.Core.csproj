  <PropertyGroup>
    <Description>FlinkNet core. Port of the Apache Flink flink-core module.</Description>
    <RootNamespace>FlinkNet</RootNamespace>
    <!-- core.memory implements MemorySegment over native memory -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlinkNet.Annotations\FlinkNet.Annotations.csproj" />
    <ProjectReference Include="..\FlinkNet.Core.Api\FlinkNet.Core.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.0.0" />
  </ItemGroup>

</Project>
